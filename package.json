{
    "name": "pintomind-player",
    "version": "2.0.9",
    "description": "Player app for PinToMind",
    "main": "src/main/main.js",
    "scripts": {
        "test": "jest",
        "start": "electron .",
        "dist": "electron-builder --linux",
        "log": "scripts/log",
        "ssh": "scripts/ssh",
        "scan": "scripts/scan_for_pi",
        "publish": "scripts/publish",
        "deploy_deb": "scripts/deploy_deb",
        "build_and_publish": "npm run dist && npm run publish --",
        "build_and_deploy_deb": "npm run dist && npm run deploy_deb --"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/favo/pintomind-os-player.git"
    },
    "build": {
        "appId": "com.favo.app",
        "productName": "pintomind-player",
        "linux": {
            "category": "Utility",
            "packageCategory": "utils",
            "executableName": "pintomind-player",
            "artifactName": "pintomind-player_${version}_${arch}.${ext}",
            "maintainer": "Favo AS <develop@favo.no>",
            "extraFiles": [
                {
                    "from": "debian/systemd/",
                    "to": "etc/systemd/user/"
                }
            ],
            "target": {
                "target": "deb",
                "arch": [
                    "arm64"
                ]
            }
        },
        "deb": {
            "afterInstall": "debian/postinst",
            "depends": [
                "pintomind-player-runtime",
                "pintomind-ble-bridge",
                "pintomind-player-controller"
            ]
        }
    },
    "author": {
        "name": "Favo AS",
        "email": "favo@post.no"
    },
    "license": "ISC",
    "bugs": {
        "url": "https://github.com/favo/pintomind-os-player/issues"
    },
    "homepage": "https://github.com/favo/pintomind-os-player#readme",
    "devDependencies": {
        "electron": "^36.2.0",
        "electron-builder": "^26.0.12",
        "jest": "^29.7.0"
    },
    "dependencies": {
        "@appsignal/javascript": "^1.3.30",
        "electron-dl": "^3.5.0",
        "electron-json-storage": "^4.6.0",
        "electron-shutdown-command": "^2.0.1",
        "electron-store": "^8.1.0",
        "electron-updater": "^6.3.9",
        "i": "^0.3.7",
        "qrcode": "^1.5.3",
        "shell-quote": "^1.8.1",
        "socket.io-client": "^4.7.1",
        "systeminformation": "^5.18.7"
    }
}
