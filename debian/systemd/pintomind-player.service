[Unit]
Description=PinToMind Player
After=pintomind-audio.service pintomind-display.service
Requires=pintomind-audio.service pintomind-display.service

[Service]
Type=simple
Environment=DISPLAY=:0
Environment=XAUTHORITY=/home/pi/.Xauthority
Environment=DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/1000/bus
StandardOutput=null
StandardError=null
ExecStart=/opt/pintomind-player/pintomind-player
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target

